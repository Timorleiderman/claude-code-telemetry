# Point Claude Code at the local collector.
#   source ./claude-telemetry.env && claude
# For an always-on setup, put these in ~/.claude/settings.json instead (see README).

export CLAUDE_CODE_ENABLE_TELEMETRY=1

export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp

export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Default is 60s/5s. Shorter makes the dashboard feel live while you test.
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Prometheus is a cumulative store; Claude Code defaults to delta.
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

# Useful extra dimensions on every metric (off by default).
export OTEL_METRICS_INCLUDE_VERSION=true
export OTEL_METRICS_INCLUDE_ENTRYPOINT=true

# Tag your data (team, machine, whatever you want to slice by).
export OTEL_RESOURCE_ATTRIBUTES="host.name=$(hostname -s)"

# --- Content logging: off by default, and it is your prompt text. ---
# Everything below lands in Loki in plaintext. Enable deliberately.
# export OTEL_LOG_USER_PROMPTS=1
# export OTEL_LOG_ASSISTANT_RESPONSES=1
# export OTEL_LOG_TOOL_DETAILS=1
